{
  "name": "@trimwares/trace",
  "version": "1.5.3",
  "type": "module",
  "description": "Local-first LLM cost tracker — no proxy, no cloud, no account. npm install is the entire infrastructure. Token attribution, optimization recommendations, and a 7-day local dashboard. OpenAI · Anthropic · Groq · Gemini · Ollama.",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "!dist/**/*.map",
    "bin/trimwares.js",
    "bin/postinstall.js",
    "assets/**",
    "ui/**",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "trimwares": "bin/trimwares.js"
  },
  "scripts": {
    "build": "tsc && rollup -c",
    "build:ui": "cd ../trimwares-dashboard && npm run build && cd ../llm-cost-trimmer && node -e \"const {rmSync,cpSync}=require('fs');rmSync('ui',{recursive:true,force:true});cpSync('../trimwares-dashboard/out','ui',{recursive:true,dereference:true});\"",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js --config jest.config.cjs --passWithNoTests",
    "test:watch": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js --config jest.config.cjs --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js --config jest.config.cjs --coverage --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "postinstall": "node bin/postinstall.js",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "llm",
    "ai-cost",
    "llm-cost",
    "cost-optimization",
    "local-first",
    "no-proxy",
    "token-attribution",
    "llm-observability",
    "ai-cost-tracker",
    "llm-monitoring",
    "ai-monitoring",
    "openai-cost",
    "anthropic-cost",
    "groq-cost",
    "gemini-cost",
    "claude-cost",
    "llm-cache",
    "semantic-cache",
    "ai-finops",
    "ai-cost-reduction",
    "token-optimization",
    "cost-trimmer",
    "llm-savings",
    "typescript"
  ],
  "author": "TTHBfo2 <tthbfo2@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TTHBfo2/trace-free.git"
  },
  "bugs": {
    "url": "https://github.com/TTHBfo2/trace-free/issues"
  },
  "homepage": "https://www.trimwares.com/trace",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "@xenova/transformers": "^2.17.2",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "openai": "^6.41.0",
    "rollup": "^4.54.0",
    "ts-jest": "^29.1.1",
    "tslib": "^2.8.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.20.0",
    "openai": ">=4.0.0",
    "@xenova/transformers": "^2.17.2"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@xenova/transformers": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "tiktoken": "^1.0.22"
  }
}
