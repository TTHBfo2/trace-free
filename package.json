{
  "name": "@tthbfo2/llm-cost-trimmer",
  "version": "0.1.0",
  "type": "module",
  "description": "The thing you install before your AI costs spiral. Drop-in LLM cost attribution + optimization middleware. See exactly where your AI money goes — system prompts, tool schemas, RAG chunks, history. No prompt content stored. No extra AI calls.",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.map",
    "bin/trimwares.js",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "trimwares": "./bin/trimwares.js"
  },
  "scripts": {
    "build": "tsc && rollup -c",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js --config jest.config.cjs",
    "test:watch": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js --config jest.config.cjs --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js --config jest.config.cjs --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "llm",
    "ai-cost",
    "cost-optimization",
    "token-optimization",
    "semantic-cache",
    "llm-cache",
    "openai-cost",
    "anthropic-cost",
    "gemini-cost",
    "ai-finops",
    "prompt-compression",
    "agent-optimization",
    "agentic-caching",
    "llm-observability",
    "ai-cost-reduction",
    "cost-trimmer",
    "token-compression",
    "llm-savings",
    "ai-spending",
    "typescript"
  ],
  "author": "TTHBfo2 <tthbfo2@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TTHBfo2/llm-cost-trimmer"
  },
  "bugs": {
    "url": "https://github.com/TTHBfo2/llm-cost-trimmer/issues"
  },
  "homepage": "https://github.com/TTHBfo2/llm-cost-trimmer#readme",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "rollup": "^4.54.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "openai": ">=4.0.0",
    "@anthropic-ai/sdk": ">=0.20.0"
  },
  "peerDependenciesMeta": {
    "openai": { "optional": true },
    "@anthropic-ai/sdk": { "optional": true }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
